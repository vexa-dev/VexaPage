    "type": "git",
    "url": "git+https://github.com/vexa-dev/VexaPage.git"
  },
  "homepage": "https://vexa.space",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
