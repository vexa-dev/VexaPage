{
  "name": "vexapage",
  "private": true,
  "version": "2.0.0",
  "description": "Landing page oficial de VEXA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\" \"*.{ts,js,json,html,md}\""
